{
  "name": "ensojs-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-22",

  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },

  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "routes": [
    {
      "pattern": "ensojs.dev",
      "custom_domain": true
    },
    {
      "pattern": "docs.ensojs.dev",
      "custom_domain": true
    }
  ]
}